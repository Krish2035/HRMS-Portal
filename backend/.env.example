NODE_ENV=development
PORT=5000
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hrms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_dev_password
DATABASE_URL=postgresql://postgres:postgres_secure_dev_password@localhost:5432/hrms_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_minimum_32_characters_random_string_hrms_2026
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_minimum_32_characters_random_string_hrms_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=dev_cookie_secret_minimum_32_characters_random_string_hrms_2026

# Logging
LOG_LEVEL=debug
