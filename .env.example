# ==============================================================================
# HRMS Portal - Global Environment Configuration Template
# ==============================================================================
# DO NOT commit real secrets to Git. Copy this file to .env for local development.

# --- General System Environment ---
NODE_ENV=development
PORT=5000
APP_NAME=HRMS-Enterprise-Portal
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# --- PostgreSQL Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hrms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_dev_password
DATABASE_URL=postgresql://postgres:postgres_secure_dev_password@localhost:5432/hrms_db
DB_POOL_MIN=2
DB_POOL_MAX=20

# --- Redis Caching, Sessions, & Queues ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# --- Authentication & Cryptography ---
# Generate high-entropy keys using: openssl rand -base64 48
JWT_ACCESS_SECRET=dev_jwt_access_secret_minimum_32_characters_random_string_hrms_2026
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_minimum_32_characters_random_string_hrms_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=dev_cookie_secret_minimum_32_characters_random_string_hrms_2026
SESSION_SECRET=dev_session_secret_minimum_32_characters_random_string_hrms_2026

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# --- Frontend URLs ---
EMPLOYEE_PORTAL_URL=http://localhost:3000
ADMIN_PORTAL_URL=http://localhost:5173
BACKEND_API_URL=http://localhost:5000/api/v1

# --- Logging & Monitoring ---
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
